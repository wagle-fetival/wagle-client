# 로그 파일 (실행 중에 자동으로 생기는 기록, 올릴 필요 없음)
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 설치된 라이브러리 폴더 (npm install로 누구나 다시 받을 수 있어서 안 올림)
node_modules
# 빌드 결과물 폴더 (npm run build 하면 다시 생김)
dist
dist-ssr
# 내 컴퓨터에서만 쓰는 설정 파일 (.env.local 등)
*.local

# 에디터 관련 파일
# .vscode 폴더 안의 파일은 기본적으로 전부 안 올림
.vscode/*
# 단, 아래처럼 앞에 !를 붙인 파일은 예외로 올림
!.vscode/extensions.json
# 추가: 팀원 모두 같은 저장 설정을 쓰도록 settings.json도 올림
!.vscode/settings.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?